# Redis (Upstash). Empty = in-memory (single-server test only).
REDIS_URL=rediss://default:YOUR_TOKEN@your-db.upstash.io:6379

# REQUIRED: change before production. Signs auth tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=change-me

# Legacy shared token (optional). Matching clients join as user "__shared__".
CHAT_TOKEN=

# eventlet = WebSocket; threading = waitress + polling.
SOCKETIO_ASYNC_MODE=eventlet

MAX_MSGS=500
TOKEN_TTL=604800
CORS_ORIGINS=*

# Client only (server ignores). Comma-separated server list.
CHAT_SERVERS=
